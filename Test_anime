<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ARE YOU ORIGIN — test</title>
<meta name="robots" content="noindex">
<style>
  :root{--bg:#0b0b0b;--fg:#f2f0ea;--accent:#d4ff3a;--muted:#8c8a84}
  *{box-sizing:border-box;margin:0;padding:0}
  html{background:var(--bg)}
  body{background:var(--bg);color:var(--fg);font-family:system-ui,-apple-system,"Segoe UI",sans-serif;height:420vh}
  #bg{position:fixed;inset:0;width:100%;height:100%;display:block}
  .shade{position:fixed;inset:0;background:radial-gradient(ellipse at center,rgba(11,11,11,.15),rgba(11,11,11,.75));pointer-events:none}
  header{position:fixed;top:0;left:0;right:0;display:flex;justify-content:space-between;align-items:center;padding:clamp(16px,3vw,32px);font-size:12px;letter-spacing:.25em;text-transform:uppercase;z-index:3}
  header a{color:var(--fg);text-decoration:none}
  .stage{position:fixed;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;text-align:center;padding:0 20px 14vh;z-index:2}
  .kicker{font-size:11px;letter-spacing:.3em;text-transform:uppercase;color:var(--accent);margin-bottom:2vh}
  .titles{position:relative;width:100%;height:clamp(150px,30vw,300px)}
  .t{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
     font-family:Impact,"Haettenschweiler","Arial Narrow Bold","Arial Black",sans-serif;
     font-weight:900;text-transform:uppercase;line-height:.92;letter-spacing:-.01em;
     font-size:clamp(46px,11vw,150px);opacity:0;transform:translateY(24px);transition:opacity .6s ease,transform .6s ease}
  .t.on{opacity:1;transform:none}
  .t .q{color:var(--accent)}
  .sub{margin-top:2vh;max-width:34ch;font-size:15px;line-height:1.5;color:#cfcdc6;min-height:3em}
  .cta{margin-top:3vh;color:var(--fg);text-decoration:none;font-size:12px;letter-spacing:.25em;text-transform:uppercase;border-bottom:1px solid var(--fg);padding-bottom:6px}
  .cta:hover{color:var(--accent);border-color:var(--accent)}
  .prog{position:fixed;bottom:4vh;left:0;right:0;display:flex;justify-content:center;align-items:center;gap:16px;font-size:10px;letter-spacing:.25em;text-transform:uppercase;color:var(--muted);z-index:3}
  .bar{width:100px;height:1px;background:#3a3a37;position:relative}
  .bar i{position:absolute;left:0;top:0;height:1px;background:var(--accent);width:0}
  @media (prefers-reduced-motion:reduce){.t{transition:none}}
</style>
</head>
<body>
<canvas id="bg" aria-hidden="true"></canvas>
<div class="shade"></div>
<header><a href="./">Are You Origin</a><a href="./">Retour</a></header>

<main class="stage">
  <p class="kicker">Valais / 2026</p>
  <div class="titles" aria-live="polite">
    <h1 class="t on"><span>Are you</span></h1>
    <h1 class="t"><span>Origin<span class="q">?</span></span></h1>
    <h1 class="t"><span>Tu es<br>des nôtres</span></h1>
  </div>
  <p class="sub" id="sub">Une marque, des soirées, une origine.</p>
  <a class="cta" href="./">Suivre le lancement</a>
</main>

<div class="prog"><span>Scroll</span><div class="bar"><i id="fill"></i></div><span id="count">01 / 03</span></div>

<script>
(function(){
  var cv=document.getElementById('bg'),ctx=cv.getContext('2d');
  var W,H,dpr,p=0,target=0,t0=performance.now();
  var reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var titles=document.querySelectorAll('.t'),sub=document.getElementById('sub');
  var subs=["Une marque, des soirées, une origine.","Une question simple. Une réponse qui se vit.","Rejoins le premier chapitre : Are You x Techno."];
  var count=document.getElementById('count'),fill=document.getElementById('fill'),cur=-1;

  function resize(){
    dpr=Math.min(window.devicePixelRatio||1,2);
    W=cv.clientWidth;H=cv.clientHeight;
    cv.width=W*dpr;cv.height=H*dpr;ctx.setTransform(dpr,0,0,dpr,0,0);
  }
  function scrollP(){
    var m=document.documentElement.scrollHeight-innerHeight;
    target=m>0?Math.min(1,Math.max(0,scrollY/m)):0;
  }
  function setStep(i){
    if(i===cur)return;cur=i;
    titles.forEach(function(el,k){el.classList.toggle('on',k===i)});
    sub.textContent=subs[i];
    count.textContent='0'+(i+1)+' / 03';
  }
  function draw(now){
    var t=(now-t0)/1000;
    p+=(target-p)*(reduce?1:.08);
    ctx.fillStyle='#0b0b0b';ctx.fillRect(0,0,W,H);
    // barres verticales façon égaliseur : plus on scrolle, plus elles montent
    var cols=Math.max(18,Math.floor(W/28)),w=W/cols;
    for(var i=0;i<cols;i++){
      var x=i*w+w/2;
      var wave=Math.sin(i*.45+t*(reduce?0:1.6))*.5+.5;
      var wave2=Math.sin(i*.17-t*(reduce?0:.9))*.5+.5;
      var h=H*(0.04+p*0.75*(0.35+0.65*wave)*(0.5+0.5*wave2));
      var a=0.12+p*0.6;
      ctx.fillStyle='rgba(212,255,58,'+a.toFixed(3)+')';
      ctx.fillRect(x-w*0.18,H-h,w*0.36,h);
    }
    // cercle central qui s'ouvre avec le scroll
    var r=Math.min(W,H)*(0.08+p*0.42);
    ctx.strokeStyle='rgba(242,240,234,'+(0.15+p*0.25).toFixed(3)+')';
    ctx.lineWidth=1;
    ctx.beginPath();ctx.arc(W/2,H*0.42,r,0,Math.PI*2);ctx.stroke();
    ctx.beginPath();ctx.arc(W/2,H*0.42,r*0.6+Math.sin(t)*(reduce?0:6),0,Math.PI*2);ctx.stroke();
    // grain léger
    for(var g=0;g<60;g++){
      ctx.fillStyle='rgba(242,240,234,.05)';
      ctx.fillRect(Math.random()*W,Math.random()*H,1.2,1.2);
    }
    setStep(Math.min(2,Math.floor(p*3*0.999)));
    fill.style.width=(p*100)+'%';
    requestAnimationFrame(draw);
  }
  addEventListener('resize',function(){resize();scrollP()});
  addEventListener('scroll',scrollP,{passive:true});
  resize();scrollP();p=target;requestAnimationFrame(draw);
})();
</script>
</body>
</html>
